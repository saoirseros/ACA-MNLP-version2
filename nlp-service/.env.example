# Host/port the FastAPI service binds to
NLP_SERVICE_HOST=0.0.0.0
NLP_SERVICE_PORT=8000

# Comma-separated list of origins allowed to call this service directly
# (mainly useful during local development). Use "*" to allow all.
NLP_ALLOWED_ORIGINS=*

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
NLP_LOG_LEVEL=INFO
