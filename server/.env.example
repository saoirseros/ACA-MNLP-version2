# MongoDB connection string (without the trailing database name; "/chat-app" is appended in lib/db.js)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Secret used to sign/verify JWTs. Use a long random string in real environments.
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary credentials, used for profile picture and chat image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port the Express/Socket.io server listens on in development
PORT=5000

# Runtime mode; production mode skips the local HTTP listener
NODE_ENV=development

# Base URL of the Python NLP service (added in Phase 3). Leave unset to run chat without NLP analysis.
NLP_SERVICE_URL=http://localhost:8000
